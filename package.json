{
  "name": "guitar-composer-studio",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:portable": "tsc -b && node scripts/build-portable.mjs",
    "build:release": "npm run build && npm run build:portable && node scripts/package-release.mjs",
    "publish:pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@tonaljs/tonal": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
